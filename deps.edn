{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.google.genai/google-genai {:mvn/version "1.57.0"}
        metosin/malli {:mvn/version "0.20.3"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1"
                 :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   ;; Testes marcados com ^:integration (ex: chamadas reais ao Gemini) ficam
   ;; de fora por padrão — ver test/adk/genai/content_test.clj.
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:excludes [:integration]}
   :main-opts ["-m" "cognitect.test-runner" "-e" "integration"]}

  :test-integration
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1"
                 :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
   :ns-default build}

  :repl
  {:extra-paths ["test" "examples"]}}}
